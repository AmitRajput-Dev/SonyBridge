# Sony RFCOMM framing, escape, data-type, and XM4 v1 command tokens.
start="\x3e"
end="\x3c"
escape="\x3d"
escaped_start="\x3d\x2e"
escaped_end="\x3d\x2c"
escaped_escape="\x3d\x2d"
ack="\x01"
data_mdr="\x0c"
zero_size="\x00\x00\x00\x00"
size_two="\x00\x00\x00\x02"
size_eight="\x00\x00\x00\x08"
size_max="\x00\x00\x07\xf9"
size_overflow="\xff\xff\xff\xff"
init="\x00\x00"
firmware="\x04\x02"
battery="\x10\x00"
codec="\x18\x00"
equalizer="\x56\x01"
ambient="\x66\x02"
dsee="\xe6\x02"
auto_power_off="\xf6\x04"
speak_to_chat="\xf6\x05"
